<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OBA Doceria | Cardápio Interativo Oficial 2026</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-[#FFF8F0] text-[#3B2A1E] font-sans antialiased">

  <div id="custom-toast" class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-6 py-4 rounded-2xl shadow-2xl transition-all duration-300 max-w-sm w-11/12 transform translate-y-0 opacity-0 pointer-events-none">
    <span id="toast-text" class="font-bold text-center w-full"></span>
  </div>

  <div id="modal" class="fixed inset-0 bg-black bg-opacity-80 hidden z-50 flex items-center justify-center p-4" onclick="closeModal()">
    <div class="bg-white max-w-2xl w-full rounded-3xl p-8 relative shadow-2xl" onclick="event.stopPropagation()">
      <button onclick="closeModal()" class="absolute top-4 right-4 bg-gray-100 hover:bg-gray-200 rounded-full p-3 z-10 transition-all text-gray-600">✕</button>
      
      <h2 id="modal-title" class="text-3xl font-extrabold text-[#8B4513] mb-6 text-center"></h2>
      
      <div class="w-full h-[50vh] flex items-center justify-center bg-gray-50 rounded-2xl mb-6 overflow-hidden border border-gray-100">
          <img id="modal-img" src="" alt="Doce" class="max-h-full max-w-full object-contain p-2" onerror="handleImageError(this, this.alt)">
      </div>
      
      <div class="flex items-center justify-between border-t border-gray-100 pt-6">
        <div class="flex flex-col">
          <span class="text-xs text-gray-400 font-bold uppercase tracking-wider">Preço Unitário</span>
          <span id="modal-price" class="text-3xl font-black text-[#8B4513]"></span>
        </div>
        <button id="modal-add-btn" class="px-10 py-4 bg-[#8B4513] text-white rounded-2xl font-bold shadow-lg hover:bg-[#6e3710] transition-transform active:scale-95 text-lg"></button>
      </div>
    </div>
  </div>

  <header class="py-12 text-center bg-gradient-to-b from-[#FFF0E0] to-[#FFF8F0] px-4">
    <h1 class="text-5xl font-extrabold text-[#8B4513] tracking-tight">OBA Doceria</h1>
    <p class="text-[#D8B36A] uppercase tracking-widest text-sm mt-3 font-semibold">O Verdadeiro Sabor Artesanal • Cardápio Completo 2026</p>
    <p class="text-xs text-gray-500 mt-2 max-w-md mx-auto">Sem atalhos: Geleias e reduções de frutas preparadas artesanalmente. Receitas equilibradas e sem conservantes.</p>
  </header>

  <main class="max-w-6xl mx-auto px-4 pb-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <div class="lg:col-span-8 space-y-8">
        
        <section class="bg-white p-6 rounded-3xl border border-[#E8D5B5] shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-[#8B4513] text-white w-7 h-7 rounded-full flex items-center justify-center font-bold text-sm">1</span>
            <h2 class="text-xl font-bold text-[#8B4513]">Selecione o tamanho da sua caixa</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3" id="opcoes-caixas"></div>
        </section>

        <section class="space-y-4">
          <div class="relative w-full">
            <input type="text" id="busca-sabor" oninput="filtrarSaboresManual()" placeholder="🔎 Digite para buscar um sabor..." class="w-full px-5 py-4 bg-white rounded-2xl border border-[#E8D5B5] focus:outline-none focus:ring-2 focus:ring-[#8B4513] text-[#3B2A1E]">
          </div>
          <div class="flex gap-2 overflow-x-auto pb-2 no-scrollbar" id="abas-categorias"></div>
        </section>

        <section>
          <div id="cardapio-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6"></div>
        </section>
      </div>

      <div class="lg:col-span-4 lg:sticky lg:top-4 h-fit">
        <section class="bg-white p-6 rounded-3xl border border-[#E8D5B5] shadow-lg space-y-6">
          <div class="border-b border-[#E8D5B5] pb-4">
            <h2 class="text-xl font-bold text-[#8B4513]">Resumo da Encomenda</h2>
            <p class="text-xs text-gray-500 mt-1">Configure sua caixa para finalizar</p>
          </div>

          <div class="space-y-3" id="painel-progresso">
            <div class="flex justify-between text-sm font-semibold">
              <span id="label-progresso-doces">Selecione uma caixa</span>
              <span id="contagem-doces">0 / 0</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden">
              <div id="barra-progresso" class="bg-[#8B4513] h-full transition-all duration-300 w-0"></div>
            </div>
            <div id="status-sabores" class="text-xs font-medium text-gray-600">Escolha de sabores: 0 sabores escolhidos.</div>
          </div>

          <div class="border-t border-b border-gray-100 py-4 max-h-[25vh] overflow-y-auto space-y-2 no-scrollbar" id="lista-selecionados">
            <p class="text-sm text-gray-400 text-center py-4">Nenhum sabor selecionado ainda.</p>
          </div>

          <div class="space-y-4">
            <div class="flex justify-between items-center text-lg font-bold">
              <span>Valor Total:</span>
              <span class="text-2xl text-[#8B4513]" id="valor-total">R$ 0,00</span>
            </div>

            <div class="space-y-3">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Seu Nome *</label>
                <input type="text" id="nome-cliente" placeholder="Seu nome completo" class="w-full px-4 py-3 bg-[#FFF8F0] border border-[#E8D5B5] rounded-xl text-sm focus:outline-none focus:ring-1 focus:ring-[#8B4513]" oninput="atualizarEstadoBotao()">
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Data de Entrega Desejada *</label>
                <input type="date" id="data-desejada" class="w-full px-4 py-3 bg-[#FFF8F0] border border-[#E8D5B5] rounded-xl text-sm focus:outline-none focus:ring-1 focus:ring-[#8B4513]" oninput="atualizarEstadoBotao()">
              </div>
            </div>

            <button id="btn-whatsapp" onclick="enviarPedidoWhatsApp()" disabled class="w-full py-4 bg-[#8B4513] text-white rounded-2xl font-bold text-lg shadow-lg hover:bg-[#6e3710] disabled:bg-gray-200 disabled:text-gray-400 disabled:shadow-none transition-all flex items-center justify-center gap-2">
              WhatsApp Encomendar
            </button>
          </div>
        </section>
      </div>

    </div>
  </main>

  <script>
    const caixas = {
      '25': { id: '25', titulo: 'Caixa de 25 Doces', limiteSabores: 7, totalDoces: 25 },
      '35': { id: '35', titulo: 'Caixa de 35 Doces', limiteSabores: 7, totalDoces: 35 },
      '50': { id: '50', titulo: 'Caixa de 50 Doces', limiteSabores: 10, totalDoces: 50 },
      '100': { id: '100', titulo: 'Caixa de 100 Doces', limiteSabores: 14, totalDoces: 100 },
      'degustacao': { id: 'degustacao', titulo: 'Caixa Degustação (25 Sabores Sortidos)', limiteSabores: 0, totalDoces: 25, precoFixo: 75.00 }
    };

    const catalogo = [
      {
        categoria: "Tradicionais I (R$ 2,50)",
        itens: [
          { id: "leite_ninho_250", nome: "Leite Ninho", preco: 2.50, desc: "O clássico favorito feito inteiramente com leite em pó premium.", img: "Images/Leite Ninho.jpeg" },
          { id: "nesquik_250", nome: "Nesquik", preco: 2.50, desc: "A doçura marcante e nostálgica do brigadeiro de morango Nesquik.", img: "Images/Nesquik.jpeg" },
          { id: "casadinho_250", nome: "Casadinho", preco: 2.50, desc: "A fusão perfeita entre brigadeiro ao leite e branquinho de leite ninho.", img: "Images/Casadinho.jpeg" },
          { id: "dois_amores_250", nome: "Dois amores", preco: 2.50, desc: "A deliciosa união entre brigadeiro ao leite tradicional e Nesquik.", img: "Images/Dois Amores.jpeg" },
          { id: "cappuccino_250", nome: "Cappuccino", preco: 2.50, desc: "Delicioso equilíbrio aromático de brigadeiro ao leite, leite ninho e um toque de café.", img: "Images/Cappuccino.jpeg" },
          { id: "napolitano_250", nome: "Napolitano", preco: 2.50, desc: "Três deliciosos sabores integrados: ao leite, leite ninho e Nesquik.", img: "Images/Napolitano.jpeg" },
          { id: "coco_250", nome: "Coco", preco: 2.50, desc: "Brigadeiro branco cozido lentamente envolvido por flocos de coco ralado.", img: "Images/Coco.jpeg" },
          { id: "coco_queimado_250", nome: "Coco queimado", preco: 2.50, desc: "Cremosa massa de coco envolvida por coco queimado crocante.", img: "Images/Coco Queimado.jpeg" }
        ]
      },
      {
        categoria: "Tradicionais II (R$ 2,60)",
        itens: [
          { id: "branco_260", nome: "Branco", preco: 2.60, desc: "Clássico brigadeiro de panela branco coberto com granulado nobre.", img: "Images/Branco.jpeg" },
          { id: "ao_leite_260", nome: "Ao leite", preco: 2.60, desc: "O brigadeiro tradicional insubstituível, finalizado com granulado nobre.", img: "Images/Ao Leite.jpeg" },
          { id: "meio_amargo_260", nome: "Meio amargo", preco: 2.60, desc: "Brigadeiro preparado com cacau nobre 50% para um sabor equilibrado.", img: "Images/Meio Amargo.jpeg" },
          { id: "amargo_260", nome: "Amargo", preco: 2.60, desc: "Sabor profundo de chocolate meio amargo com cobertura de granulado nobre 70%.", img: "Images/Amargo.jpeg" },
          { id: "caramelo_260", nome: "Caramelo", preco: 2.60, desc: "Brigadeiro suave de caramelo artesanal envolvido por granulado gourmet.", img: "Images/Caramelo.jpeg" },
          { id: "duo_ao_leite_260", nome: "Duo ao leite", preco: 2.60, desc: "A combinação perfeita de chocolate ao leite e brigadeiro branco.", img: "Images/Duo Ao Leite.jpeg" },
          { id: "duo_amargo_260", nome: "Duo amargo", preco: 2.60, desc: "Elegante combinação de chocolate meio amargo e brigadeiro branco.", img: "Images/Duo Amargo.jpeg" },
          { id: "cafe_260", nome: "Café", preco: 2.60, desc: "Aroma e sabor marcante de café nobre combinado com granulado selecionado.", img: "Images/Café.jpeg" },
          { id: "amendoim_260", nome: "Amendoim", preco: 2.60, desc: "Cremosa massa de brigadeiro com xerém triturado de amendoim tostado.", img: "Images/Amendoim.jpeg" }
        ]
      }
    ];

    let caixaAtiva = null;
    let quantidades = {}; 
    let categoryActive = "Todos";

    function handleImageError(imgElement, name) {
      imgElement.onerror = null;
      imgElement.src = "Images/Leite Ninho.jpeg";
    }

    function init() {
      renderizarOpcoesCaixas();
      renderizarAbasCategorias();
      renderizarDoces();
      atualizarInterface();
    }

    function renderizarOpcoesCaixas() {
      const container = document.getElementById('opcoes-caixas');
      container.innerHTML = "";
      Object.values(caixas).forEach(box => {
        container.innerHTML += `
          <button onclick="selecionarCaixa('${box.id}')" id="btn-caixa-${box.id}" class="bg-white p-4 rounded-2xl border-2 border-[#E8D5B5] hover:border-[#8B4513] text-left transition-all relative flex flex-col justify-between shadow-sm w-full">
            <div>
              <span id="badge-caixa-${box.id}" class="hidden absolute top-3 right-3 bg-[#8B4513] text-white text-[10px] font-bold px-2 py-0.5 rounded-full">ATIVADA</span>
              <h3 class="font-extrabold text-sm text-[#8B4513] pr-12">${box.titulo}</h3>
            </div>
            <div class="mt-3 text-xs font-bold text-gray-700">${box.precoFixo ? `Preço: R$ ${box.precoFixo.toFixed(2).replace('.', ',')}` : 'Preço por un.'}</div>
          </button>
        `;
      });
    }

    function selecionarCaixa(id) {
      caixaAtiva = caixas[id];
      quantidades = {};
      Object.keys(caixas).forEach(boxId => {
        const btn = document.getElementById(`btn-caixa-${boxId}`);
        const badge = document.getElementById(`badge-caixa-${boxId}`);
        if (boxId === id) {
          btn.className = "bg-[#FFF8F0] p-4 rounded-2xl border-2 border-[#8B4513] text-left transition-all relative flex flex-col justify-between shadow-md w-full";
          if(badge) badge.classList.remove('hidden');
        } else {
          btn.className = "bg-white p-4 rounded-2xl border-2 border-[#E8D5B5] hover:border-[#8B4513] text-left transition-all relative flex flex-col justify-between shadow-sm w-full";
          if(badge) badge.classList.add('hidden');
        }
      });
      renderizarDoces();
      atualizarInterface();
    }

    function renderizarAbasCategorias() {
      const container = document.getElementById('abas-categorias');
      if (!container) return;
      container.innerHTML = `<button onclick="filtrarCategoria('Todos')" id="aba-Todos" class="px-5 py-2.5 rounded-full font-bold text-xs whitespace-nowrap transition-all shadow-sm">Todos</button>`;
      catalogo.forEach(g => {
        const idSafe = g.categoria.replace(/\s+/g, '').replace(/[^a-zA-Z0-9]/g, '');
        container.innerHTML += `
          <button onclick="filtrarCategoria('${g.categoria}')" id="aba-${idSafe}" class="px-5 py-2.5 rounded-full font-bold text-xs whitespace-nowrap transition-all shadow-sm">${g.categoria.split(" (")[0]}</button>
        `;
      });
      atualizarVisualAbas();
    }

    function filtrarCategoria(cat) {
      categoryActive = cat;
      atualizarVisualAbas();
      renderizarDoces();
    }

    function atualizarVisualAbas() {
      const abaTodos = document.getElementById('aba-Todos');
      if (!abaTodos) return;
      if (categoryActive === 'Todos') {
        abaTodos.className = "px-5 py-2.5 rounded-full font-bold text-xs whitespace-nowrap transition-all bg-[#8B4513] text-white shadow-md";
      } else {
        abaTodos.className = "px-5 py-2.5 rounded-full font-bold text-xs whitespace-nowrap transition-all bg-white text-[#8B4513] border border-[#E8D5B5] hover:bg-gray-50";
      }
      catalogo.forEach(g => {
        const idSafe = g.categoria.replace(/\s+/g, '').replace(/[^a-zA-Z0-9]/g, '');
        const btn = document.getElementById(`aba-${idSafe}`);
        if (btn) {
          if (categoryActive === g.categoria) {
            btn.className = "px-5 py-2.5 rounded-full font-bold text-xs whitespace-nowrap transition-all bg-[#8B4513] text-white shadow-md";
          } else {
            btn.className = "px-5 py-2.5 rounded-full font-bold text-xs whitespace-nowrap transition-all bg-white text-[#8B4513] border border-[#E8D5B5] hover:bg-gray-50";
          }
        }
      });
    }

    function filtrarSaboresManual() {
      renderizarDoces();
    }

    function renderizarDoces() {
      const grid = document.getElementById('cardapio-grid');
      if (!grid) return;
      grid.innerHTML = "";
      let docesExibidos = 0;
      const termoBusca = document.getElementById('busca-sabor').value.toLowerCase();

      catalogo.forEach(g => {
        if (categoryActive !== "Todos" && categoryActive !== g.categoria) return;
        g.itens.forEach(item => {
          if (termoBusca && !item.nome.toLowerCase().includes(termoBusca)) return;
          const qtd = quantidades[item.id] || 0;
          docesExibidos++;

          grid.innerHTML += `
            <div class="bg-white rounded-3xl shadow-md border border-[#E8D5B5] flex flex-col items-center text-center overflow-hidden transition-all hover:shadow-lg w-full">
              <div class="w-full aspect-square flex items-center justify-center bg-gray-50 overflow-hidden relative">
                <img src="${item.img}" alt="${item.nome}" class="h-full w-full object-cover" onerror="handleImageError(this, '${item.nome}')">
              </div>
              <div class="p-4 w-full flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="font-bold text-sm md:text-base mb-1 text-[#3B2A1E] line-clamp-1">${item.nome}</h3>
                  <button onclick="openModal('${item.img}', '${item.nome}', 'R$ ${item.preco.toFixed(2).replace('.', ',')}', '${item.id}')" class="text-xs text-[#8B4513] underline mb-3 inline-block">Ver detalhes</button>
                </div>
                <div class="w-full">
                  <p class="text-xs text-gray-500 font-semibold mb-2">R$ ${item.preco.toFixed(2).replace('.', ',')} / un</p>
                  ${caixaAtiva && caixaAtiva.id !== 'degustacao' ? `
                    <div class="flex items-center justify-between bg-[#FFF8F0] border border-[#E8D5B5] rounded-xl p-1 w-full">
                      <button onclick="alterarQtd('${item.id}', -1)" class="w-8 h-8 rounded-lg flex items-center justify-center font-black bg-white hover:bg-gray-100 text-[#8B4513] transition-colors">-</button>
                      <span class="font-bold text-sm mx-2 text-[#3B2A1E]">${qtd}</span>
                      <button onclick="alterarQtd('${item.id}', 1)" class="w-8 h-8 rounded-lg flex items-center justify-center font-black bg-[#8B4513] text-white hover:bg-[#6e3710] transition-colors">+</button>
                    </div>
                  ` : `
                    <button onclick="lembreteCaixa()" class="w-full py-2 bg-gray-100 text-gray-400 rounded-xl text-xs font-bold transition-all hover:bg-gray-200">Escolha a caixa</button>
                  `}
                </div>
              </div>
            </div>
          `;
        });
      });
    }

    function lembreteCaixa() {
      mostrarNotificacao("Ative o tamanho da caixa na Etapa 1 primeiro!", "aviso");
    }

    function alterarQtd(id, delta) {
      if (!caixaAtiva || caixaAtiva.id === 'degustacao') return;
      const qtdAtual = quantidades[id] || 0;
      const novaQtd = qtdAtual + delta;
      if (novaQtd < 0) return;

      quantidades[id] = novaQtd;
      renderizarDoces();
      atualizarInterface();
    }

    function encontrarDoce(id) {
      for (let g of catalogo) {
        for (let item of g.itens) {
          if (item.id === id) return item;
        }
      }
      return null;
    }

    function atualizarInterface() {
      const totalSelecionado = Object.values(quantidades).reduce((a, b) => a + b, 0);
      const listaContainer = document.getElementById('lista-selecionados');
      const progressContagem = document.getElementById('contagem-doces');
      const progressBar = document.getElementById('barra-progresso');
      const labelValor = document.getElementById('valor-total');

      if (!listaContainer) return;
      listaContainer.innerHTML = "";

      if (!caixaAtiva) {
        if(progressContagem) progressContagem.innerText = "0 / 0";
        if(progressBar) progressBar.style.width = "0%";
        return;
      }

      if (progressContagem) progressContagem.innerText = `${totalSelecionado} / ${caixaAtiva.totalDoces}`;
      if (progressBar) progressBar.style.width = `${(totalSelecionado / caixaAtiva.totalDoces) * 100}%`;

      let valorCalculado = 0;
      Object.entries(quantidades).forEach(([id, q]) => {
        const doce = encontrarDoce(id);
        if (doce && q > 0) {
          valorCalculado += doce.preco * q;
          listaContainer.innerHTML += `<p class="text-xs p-1">${doce.nome} x ${q}</p>`;
        }
      });

      if(labelValor) labelValor.innerText = `R$ ${valorCalculado.toFixed(2).replace('.', ',')}`;
      atualizarEstadoBotao();
    }

    function atualizarEstadoBotao() {
      const btn = document.getElementById('btn-whatsapp');
      if(btn) btn.disabled = !caixaAtiva;
    }

    function openModal(src, title, price, id) {
      document.getElementById('modal-img').src = src;
      document.getElementById('modal-title').innerText = title;
      document.getElementById('modal-price').innerText = price;
      
      const modalBtn = document.getElementById('modal-add-btn');
      if (caixaAtiva) {
        modalBtn.innerText = "Adicionar ao Pedido";
        modalBtn.onclick = function() {
          alterarQtd(id, 1);
          closeModal();
        };
      } else {
        modalBtn.innerText = "Selecionar Caixa Primeiro";
        modalBtn.onclick = function() {
          closeModal();
          lembreteCaixa();
        };
      }
      document.getElementById('modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('modal').classList.add('hidden');
    }

    function mostrarNotificacao(mensagem) {
      const toast = document.getElementById('custom-toast');
      const toastText = document.getElementById('toast-text');
      if(toastText) toastText.innerText = mensagem;
      if(toast) {
        toast.className = "fixed bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-6 py-4 rounded-2xl shadow-2xl bg-[#8B4513] text-white opacity-100 transition-all";
        setTimeout(() => { toast.className = "fixed bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-6 py-4 rounded-2xl shadow-2xl opacity-0 pointer-events-none"; }, 3000);
      }
    }

    function enviarPedidoWhatsApp() {}

    window.onload = function() {
      init();
    };
  </script>
</body>
</html>
